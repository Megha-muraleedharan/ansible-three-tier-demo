
server {
    listen 80;
    server_name _;

    location = /app1 {
        return 301 /app1/;
    }

    location /app1/ {
        proxy_pass http://127.0.0.1:5001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /app2 {
        return 301 /app2/;
    }

    location /app2/ {
        alias /var/www/app2/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    location / {
        default_type text/plain;
        return 200 "Ansible Demo: visit /app1/ or /app2/\n";
    }
}

